# ── Azure / Microsoft Graph ──────────────────────────────────────────────────
AZURE_TENANT_ID="your-azure-tenant-id"
AZURE_CLIENT_ID="your-azure-client-id"
AZURE_CLIENT_SECRET="your-azure-client-secret"

# ── Email Routing ─────────────────────────────────────────────────────────────
BPA_SALES_EMAIL="sales@brisbanepumpaction.com.au"
GCPA_SALES_EMAIL="sales@gcpumpaction.com.au"
BPA_HUBSPOT_BCC="441687953@bcc.ap1.hubspot.com"
GCPA_HUBSPOT_BCC="441687953@bcc.ap1.hubspot.com"
ACCOUNTS_BCC="accounts@brisbanepumpaction.com.au"

# ── SharePoint Drive IDs ──────────────────────────────────────────────────────
BPA_DRIVE_ID="brispump.sharepoint.com,<site-id>,<drive-id>"
GCPA_DRIVE_ID="brispump.sharepoint.com,<site-id>,<drive-id>"

# ── HubSpot ───────────────────────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN="pat-ap1-your-token-here"
TARGET_DEAL_STAGE_IDS="3522386407,3522386412,appointmentscheduled,contractsent,3529758201"

# ── Anthropic (Claude Haiku urgency classification) ───────────────────────────
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-your-key-here"

# ── Supabase (leads, quotes, sends, follow-ups, audit log) ────────────────────
# Get from: Supabase Dashboard > Project Settings > API
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_KEY="your-supabase-service-role-key"

# ── Mailbox Subscription ──────────────────────────────────────────────────────
# Secret token sent with every Graph notification so we can verify it's genuine
MAILBOX_CLIENT_STATE="bpa-sales-engine-secret"
# Your public-facing URL (ngrok in dev, production domain in prod)
# Used to register the Graph mailbox subscription on startup
PUBLIC_URL="https://xxxx.ngrok-free.app"

# ── Excel Bible Log (Phase E) ─────────────────────────────────────────────────
# SharePoint item ID of "The Bible" Excel file
# Columns: Date Sent | Customer | Level | Conditions | Travel Charge | Details on who sent to
EXCEL_BIBLE_ITEM_ID="your-excel-file-item-id"

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3000